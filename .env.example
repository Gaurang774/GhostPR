# Environment Variables — GhostPR MVP
# Copy this to .env and fill in your values

# ─── GitHub ───────────────────────────────────────────
GITHUB_TOKEN=ghp_your_token_here
GITHUB_OWNER=your-org-or-username
GITHUB_REPO=your-repo-name

# ─── Groq (Decision Extraction) ───────────────────────
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Hindsight (Vectorize Memory) ─────────────────────
HINDSIGHT_API_KEY=your_hindsight_key_here
HINDSIGHT_BANK_URL=https://api.hindsight.vectorize.io/mcp/YOUR_BANK/

# ─── SQLite ───────────────────────────────────────────
DATABASE_PATH=./data/GhostPR.db

# ─── Demo Seed ────────────────────────────────────────
# Leave false for real use — your DB starts empty and is filled only by the
# ingestion pipeline (your own repo's PRs). Set true to load 8 sample
# decisions for a demo / evaluation.
SEED_DEMO=false

# ─── App ──────────────────────────────────────────────
NODE_ENV=development
DASHBOARD_PORT=3000
MCP_PORT=8080
# Auth mode for HTTP /mcp: public (one-click OAuth, no token prompt), token (require MCP_AUTH_TOKEN), or open (no auth)
MCP_AUTH_MODE=public
# Signing secret for OAuth tokens (and required passphrase when MCP_AUTH_MODE=token)
MCP_AUTH_TOKEN=
# Optional public HTTPS origin for OAuth metadata (Render sets RENDER_EXTERNAL_URL automatically)
MCP_PUBLIC_URL=
